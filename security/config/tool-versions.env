# Versiones fijas de las herramientas de seguridad.
#
# Todas fueron verificadas con `docker manifest inspect` el 2026-08-28.
# NO usar `latest`: un pipeline de seguridad debe ser reproducible, y un cambio
# silencioso de versión invalida la comparación entre ejecuciones.
#
# Para actualizar una versión:
#   1. docker manifest inspect <imagen>:<tag>   (debe responder sin error)
#   2. Cambiar el valor acá.
#   3. Ejecutar ./security/scripts/run-all.sh y comparar contra el informe previo.
#   4. Registrar el cambio en security/README.md.

# --- SAST ---
SEMGREP_IMAGE=semgrep/semgrep:1.145.0

# --- SCA / SBOM / contenedores ---
TRIVY_IMAGE=aquasec/trivy:0.74.0
OSV_SCANNER_IMAGE=ghcr.io/google/osv-scanner:v2.2.4

# --- Secretos ---
GITLEAKS_IMAGE=zricethezav/gitleaks:v8.30.0

# --- DAST legacy (no lo invocan run-all ni los workflows frontend) ---
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.17.0
NUCLEI_IMAGE=projectdiscovery/nuclei:v3.4.10

# --- TLS legacy (sólo staging HTTPS; ejecución soportada desde backend) ---
TESTSSL_IMAGE=drwetter/testssl.sh:3.2
