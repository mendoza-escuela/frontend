# Variable pública incorporada al bundle durante el build. Usar exactamente
# /api o una URL HTTP(S) terminada en /api; el cliente no agrega el prefijo.
VITE_API_URL=http://localhost:4000/api

# Overrides públicos y opcionales, también resueltos durante el build.
# Usar rutas versionadas bajo /brand/official/.
VITE_BRAND_MENDOZA_ON_LIGHT=/brand/official/mendoza/marca-gobierno-mendoza.png
VITE_BRAND_MENDOZA_ON_BLUE=/brand/official/mendoza/marca-gobierno-mendoza.png
VITE_BRAND_OPS_ON_LIGHT=/brand/official/ops/ops-blue-horizontal.png
VITE_BRAND_OPS_ON_BLUE=/brand/official/ops/ops-white-stacked.png
